# Environment Variables
# Copy this to .env.local and fill in real values

# METRICS DASHBOARD SECURITY
METRICS_PASSWORD=YourStrongPasswordHere123!
NEXT_PUBLIC_METRICS_TOKEN=YourStrongPasswordHere123!

# OPTIONAL: IP Whitelist (comma-separated)
# ADMIN_IP_WHITELIST=192.168.1.1,10.0.0.1

# SITE CONFIG
NEXT_PUBLIC_SITE_URL=https://www.shipbridge.in
NEXT_PUBLIC_COMPANY_NAME=ShipBridge Logistics
NEXT_PUBLIC_COMPANY_EMAIL=contact@shipbridge.in
NEXT_PUBLIC_COMPANY_PHONE=+91-XXXXX-XXXXX
NEXT_PUBLIC_COMPANY_ADDRESS=Indore, Madhya Pradesh, India

# SEO
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
